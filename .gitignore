# Generated build artifacts (recreated by `charly box generate` / `charly box build`)
.build/
# Generated context-ignore files (podman reads .containerignore, docker .dockerignore)
.containerignore
.dockerignore
# Eval run scratch
.check/
# VM / disk-image build outputs
output/
# Editor scratch
*.swp
*~

# CI toolchain and corpus checkouts (the drift-gate workflow checks both out
# under .ci/); not authored artifacts, never versioned.
.ci/

# Migration rollback backups (charly migrate writes <file>.bak.<unix-ts>)
*.bak
*.bak.*
